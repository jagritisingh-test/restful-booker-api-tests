{
  "name": "restful-booker-api-test-suite",
  "version": "1.0.0",
  "description": "Automated Postman/Newman API test suite for the Restful-Booker demo API.",
  "scripts": {
    "test": "newman run postman/collections/Restful-Booker-API-Tests.postman_collection.json -e postman/environments/Restful-Booker.postman_environment.json --reporters cli,htmlextra --reporter-htmlextra-export reports/report.html",
    "test:ci": "newman run postman/collections/Restful-Booker-API-Tests.postman_collection.json -e postman/environments/Restful-Booker.postman_environment.json --reporters cli,junit --reporter-junit-export reports/junit-report.xml"
  },
  "devDependencies": {
    "newman": "^6.2.2",
    "newman-reporter-htmlextra": "^1.23.1"
  },
  "keywords": [
    "postman",
    "newman",
    "api-testing",
    "qa-automation",
    "rest-api"
  ],
  "license": "MIT",
  "main": "index.js",
  "author": "",
  "type": "commonjs"
}
